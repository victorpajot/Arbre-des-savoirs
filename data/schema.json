{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "arbre-competences/schema.json",
 "title": "Contenu de l'arbre de compétences",
 "description": "Un seul schéma pour les fichiers de contenu. Chaque fichier est validé contre sa définition dans $defs (regles, skills, questions, succes, commentaires, objets, avatar).",
 "$defs": {
  "texte": {
   "type": "object",
   "description": "Texte traduit, une clé par langue.",
   "required": [
    "fr"
   ],
   "additionalProperties": {
    "type": "string",
    "minLength": 1
   }
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
  },
  "regles": {
   "type": "object",
   "required": [
    "format",
    "stats",
    "xp",
    "quiz",
    "chrono",
    "rappels",
    "aujourdhui"
   ],
   "properties": {
    "format": {
     "const": 1
    },
    "stats": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "id",
       "nom",
       "branche",
       "couleur",
       "description"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "$ref": "#/$defs/id"
       },
       "nom": {
        "$ref": "#/$defs/texte"
       },
       "branche": {
        "$ref": "#/$defs/texte"
       },
       "couleur": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
       },
       "description": {
        "$ref": "#/$defs/texte"
       }
      }
     }
    },
    "xp": {
     "type": "object",
     "required": [
      "par_bonne_reponse",
      "bonus_maitrise",
      "par_rappel_reussi",
      "paliers_niveau"
     ],
     "properties": {
      "par_bonne_reponse": {
       "type": "integer",
       "minimum": 0
      },
      "bonus_maitrise": {
       "type": "integer",
       "minimum": 0
      },
      "par_rappel_reussi": {
       "type": "integer",
       "minimum": 0
      },
      "paliers_niveau": {
       "type": "array",
       "items": {
        "type": "integer",
        "minimum": 0
       },
       "minItems": 2
      },
      "rappel_par_etape": {
       "type": "array",
       "items": {
        "type": "integer",
        "minimum": 0
       },
       "minItems": 1,
       "description": "XP d'un rappel réussi selon l'étape atteinte (1 à n) ; au-delà, la dernière valeur."
      }
     }
    },
    "quiz": {
     "type": "object",
     "required": [
      "questions_par_quiz",
      "seuil_maitrise"
     ],
     "properties": {
      "questions_par_quiz": {
       "type": "integer",
       "minimum": 1
      },
      "seuil_maitrise": {
       "type": "number",
       "exclusiveMinimum": 0,
       "maximum": 1
      }
     }
    },
    "chrono": {
     "type": "object",
     "required": [
      "secondes",
      "bonus_xp_par_bonne_reponse"
     ],
     "properties": {
      "secondes": {
       "type": "integer",
       "minimum": 5
      },
      "bonus_xp_par_bonne_reponse": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "rappels": {
     "type": "object",
     "required": [
      "intervalles_jours",
      "questions_par_rappel",
      "bonnes_reponses_min"
     ],
     "properties": {
      "intervalles_jours": {
       "type": "array",
       "items": {
        "type": "integer",
        "minimum": 1
       },
       "minItems": 1
      },
      "questions_par_rappel": {
       "type": "integer",
       "minimum": 1
      },
      "bonnes_reponses_min": {
       "type": "integer",
       "minimum": 1
      }
     }
    },
    "aujourdhui": {
     "type": "object",
     "required": [
      "max_rappels",
      "suggestion"
     ],
     "properties": {
      "max_rappels": {
       "type": "integer",
       "minimum": 1
      },
      "suggestion": {
       "enum": [
        "stat_la_plus_faible"
       ]
      }
     }
    }
   }
  },
  "skills": {
   "type": "object",
   "required": [
    "format",
    "competences"
   ],
   "properties": {
    "format": {
     "const": 1
    },
    "competences": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "id",
       "stat",
       "rang",
       "nom",
       "description",
       "prerequis"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "$ref": "#/$defs/id"
       },
       "stat": {
        "$ref": "#/$defs/id"
       },
       "rang": {
        "type": "integer",
        "minimum": 1
       },
       "nom": {
        "$ref": "#/$defs/texte"
       },
       "description": {
        "$ref": "#/$defs/texte"
       },
       "prerequis": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/id"
        },
        "uniqueItems": true
       }
      }
     }
    }
   }
  },
  "questions": {
   "type": "object",
   "required": [
    "format",
    "questions"
   ],
   "properties": {
    "format": {
     "const": 1
    },
    "questions": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "competence",
       "type",
       "enonce",
       "reponse",
       "explication"
      ],
      "properties": {
       "id": {
        "$ref": "#/$defs/id"
       },
       "competence": {
        "$ref": "#/$defs/id"
       },
       "type": {
        "enum": [
         "qcm",
         "vrai_faux",
         "numerique"
        ]
       },
       "enonce": {
        "$ref": "#/$defs/texte"
       },
       "explication": {
        "$ref": "#/$defs/texte"
       },
       "choix": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/texte"
        },
        "minItems": 2
       },
       "reponse": {
        "type": [
         "integer",
         "number",
         "boolean"
        ]
       },
       "tolerance": {
        "type": "number",
        "minimum": 0
       },
       "unite": {
        "type": "string"
       },
       "illustration": {
        "$ref": "#/$defs/svg"
       },
       "illustration_explication": {
        "$ref": "#/$defs/svg"
       }
      },
      "allOf": [
       {
        "if": {
         "properties": {
          "type": {
           "const": "qcm"
          }
         }
        },
        "then": {
         "required": [
          "choix"
         ],
         "properties": {
          "reponse": {
           "type": "integer",
           "minimum": 0
          }
         }
        }
       },
       {
        "if": {
         "properties": {
          "type": {
           "const": "vrai_faux"
          }
         }
        },
        "then": {
         "properties": {
          "reponse": {
           "type": "boolean"
          }
         }
        }
       },
       {
        "if": {
         "properties": {
          "type": {
           "const": "numerique"
          }
         }
        },
        "then": {
         "required": [
          "tolerance"
         ],
         "properties": {
          "reponse": {
           "type": "number"
          }
         }
        }
       }
      ]
     }
    }
   }
  },
  "succes": {
   "type": "object",
   "required": [
    "format",
    "succes"
   ],
   "properties": {
    "format": {
     "const": 1
    },
    "succes": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "nom",
       "description",
       "condition",
       "cache",
       "recompense"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "$ref": "#/$defs/id"
       },
       "nom": {
        "$ref": "#/$defs/texte"
       },
       "description": {
        "$ref": "#/$defs/texte"
       },
       "cache": {
        "type": "boolean"
       },
       "condition": {
        "$ref": "#/$defs/condition"
       },
       "recompense": {
        "type": "object",
        "required": [
         "type",
         "texte",
         "source"
        ],
        "additionalProperties": false,
        "properties": {
         "type": {
          "enum": [
           "citation",
           "anecdote"
          ]
         },
         "texte": {
          "$ref": "#/$defs/texte"
         },
         "auteur": {
          "type": "string"
         },
         "source": {
          "type": "string",
          "minLength": 3
         }
        },
        "if": {
         "properties": {
          "type": {
           "const": "citation"
          }
         }
        },
        "then": {
         "required": [
          "auteur"
         ]
        }
       }
      }
     }
    }
   }
  },
  "condition": {
   "type": "object",
   "required": [
    "type"
   ],
   "additionalProperties": false,
   "description": "Condition déclarative, évaluée par le moteur (verifierSucces). Les compteurs sont dans la partie.",
   "properties": {
    "type": {
     "enum": [
      "competences_maitrisees",
      "competence_maitrisee",
      "quiz_parfaits",
      "quiz_parfaits_stat",
      "quiz_rates",
      "quiz_eclair_rates",
      "quiz_zero",
      "quiz_joues",
      "quiz_nuit",
      "quiz_aube",
      "meme_quiz_rate",
      "chrono_parfaits",
      "reponses_eclair_fausses",
      "branche_complete",
      "toutes_branches",
      "rappels_reussis",
      "rappels_retard",
      "serie_rappels",
      "duree_maitrise",
      "niveau_stat",
      "niveau_global",
      "competences_regagnees",
      "competences_perdues",
      "jours_actifs",
      "retours",
      "mode_test",
      "succes",
      "succes_obtenus",
      "objets",
      "case_atteinte",
      "case_visitee",
      "tours_plateau",
      "sorties_prison",
      "eurekas",
      "reculs",
      "branches_completes",
      "rang_maitrise"
     ]
    },
    "n": {
     "type": "integer",
     "minimum": 1
    },
    "stat": {
     "$ref": "#/$defs/id"
    },
    "id": {
     "$ref": "#/$defs/id"
    },
    "jours": {
     "type": "integer",
     "minimum": 1
    },
    "niveau": {
     "type": "integer",
     "minimum": 1
    },
    "rang_max": {
     "type": "integer",
     "minimum": 1,
     "description": "Avec branche_complete : ne compter que les compétences de rang inférieur ou égal."
    },
    "rang": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "svg": {
   "type": "string",
   "pattern": "^<svg[\\s\\S]*</svg>$",
   "description": "SVG autonome n'utilisant que les classes documentées dans outils/illustrations.py."
  },
  "pixels": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[.A-Za-z0-9!*~+]+$"
   },
   "minItems": 1,
   "description": "Image en pixel art : une chaîne par ligne, un caractère par pixel, « . » transparent, le reste renvoie à la palette (lettres et chiffres) ou aux couleurs du rang (! X * ~ Z + Q)."
  },
  "palette": {
   "type": "object",
   "propertyNames": {
    "pattern": "^[A-Za-z0-9!*~+]$"
   },
   "additionalProperties": {
    "type": "string",
    "pattern": "^#[0-9A-Fa-f]{6}$"
   }
  },
  "commentaires": {
   "type": "object",
   "required": [
    "format",
    "narrateur",
    "commentaires"
   ],
   "properties": {
    "format": {
     "const": 2
    },
    "narrateur": {
     "$ref": "#/$defs/texte"
    },
    "commentaires": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "id",
       "contexte",
       "texte"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "$ref": "#/$defs/id"
       },
       "texte": {
        "$ref": "#/$defs/texte"
       },
       "contexte": {
        "enum": [
         "accueil",
         "quiz_parfait_facile",
         "quiz_parfait",
         "quiz_reussi",
         "quiz_rate_facile",
         "quiz_rate",
         "quiz_zero",
         "rappel_reussi",
         "rappel_perdu",
         "rappel_retard",
         "nuit",
         "mode_test",
         "eclair",
         "retour",
         "retards",
         "livre",
         "date",
         "masque",
         "plateau_avance",
         "eureka",
         "piege",
         "prison",
         "prison_liberation",
         "quarantaine",
         "retour_epoque",
         "tour_fini",
         "bonus_du_jour"
        ]
       },
       "reference": {
        "type": "boolean",
        "description": "La réplique fait référence à l'histoire des sciences."
       }
      }
     }
    }
   }
  },
  "objets": {
   "type": "object",
   "required": [
    "format",
    "palette",
    "taille",
    "objets"
   ],
   "properties": {
    "format": {
     "const": 2
    },
    "palette": {
     "$ref": "#/$defs/palette"
    },
    "taille": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     },
     "minItems": 2,
     "maxItems": 2
    },
    "objets": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "id",
       "nom",
       "annee",
       "notice",
       "source",
       "condition",
       "pixels"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "$ref": "#/$defs/id"
       },
       "nom": {
        "$ref": "#/$defs/texte"
       },
       "annee": {
        "type": [
         "integer",
         "null"
        ]
       },
       "notice": {
        "$ref": "#/$defs/texte"
       },
       "source": {
        "type": "string",
        "minLength": 3
       },
       "condition": {
        "$ref": "#/$defs/condition"
       },
       "pixels": {
        "$ref": "#/$defs/pixels"
       }
      }
     }
    }
   }
  },
  "avatar": {
   "type": "object",
   "required": [
    "format",
    "palette",
    "taille",
    "corps",
    "cheveux",
    "rangs",
    "accessoires"
   ],
   "properties": {
    "format": {
     "const": 2
    },
    "palette": {
     "$ref": "#/$defs/palette"
    },
    "taille": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     },
     "minItems": 2,
     "maxItems": 2
    },
    "corps": {
     "$ref": "#/$defs/pixels"
    },
    "cheveux": {
     "$ref": "#/$defs/pixels"
    },
    "rangs": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "id",
       "nom",
       "niveau_min",
       "couleurs",
       "tenue"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "$ref": "#/$defs/id"
       },
       "nom": {
        "$ref": "#/$defs/texte"
       },
       "niveau_min": {
        "type": "integer",
        "minimum": 0
       },
       "couleurs": {
        "$ref": "#/$defs/palette"
       },
       "tenue": {
        "$ref": "#/$defs/pixels"
       }
      }
     }
    },
    "accessoires": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "nom",
       "emplacement",
       "condition",
       "pixels"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "$ref": "#/$defs/id"
       },
       "nom": {
        "$ref": "#/$defs/texte"
       },
       "emplacement": {
        "enum": [
         "tete",
         "visage"
        ]
       },
       "condition": {
        "$ref": "#/$defs/condition"
       },
       "pixels": {
        "$ref": "#/$defs/pixels"
       }
      }
     }
    },
    "emplacements": {
     "type": "string",
     "description": "Caractères dont la couleur dépend du rang."
    }
   }
  },
  "ia": {
   "type": "object",
   "required": [
    "format",
    "nom",
    "palette",
    "taille",
    "expressions",
    "masques"
   ],
   "additionalProperties": false,
   "properties": {
    "format": {
     "const": 2
    },
    "nom": {
     "$ref": "#/$defs/texte"
    },
    "palette": {
     "$ref": "#/$defs/palette"
    },
    "taille": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     },
     "minItems": 2,
     "maxItems": 2
    },
    "expressions": {
     "type": "object",
     "description": "Expression du masque pour chaque contexte de réplique.",
     "additionalProperties": {
      "enum": [
       "neutre",
       "moqueuse",
       "impressionnee",
       "decue",
       "impatiente"
      ]
     }
    },
    "masques": {
     "type": "array",
     "minItems": 24,
     "items": {
      "type": "object",
      "required": [
       "id",
       "nom",
       "notice",
       "source",
       "base",
       "expressions"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "$ref": "#/$defs/id"
       },
       "nom": {
        "$ref": "#/$defs/texte"
       },
       "notice": {
        "$ref": "#/$defs/texte"
       },
       "base": {
        "$ref": "#/$defs/pixels"
       },
       "expressions": {
        "type": "object",
        "required": [
         "neutre",
         "moqueuse",
         "impressionnee",
         "decue",
         "impatiente"
        ],
        "additionalProperties": {
         "$ref": "#/$defs/pixels"
        }
       },
       "condition": {
        "$ref": "#/$defs/condition",
        "description": "Ce qui débloque le masque. Absente : le masque est là dès le début."
       },
       "source": {
        "type": "string",
        "minLength": 3
       }
      }
     }
    }
   }
  },
  "plateau": {
   "type": "object",
   "required": [
    "format",
    "regles",
    "epoques",
    "palette",
    "taille",
    "icones",
    "cases"
   ],
   "additionalProperties": false,
   "properties": {
    "format": {
     "const": 1
    },
    "regles": {
     "type": "object",
     "required": [
      "depart",
      "arrivee",
      "valeurs",
      "bonus",
      "echec",
      "tour_suivant",
      "textes"
     ],
     "properties": {
      "depart": {
       "type": "integer"
      },
      "arrivee": {
       "type": "integer"
      },
      "valeurs": {
       "type": "object",
       "required": [
        "rappel",
        "quiz_rang"
       ],
       "properties": {
        "rappel": {
         "type": "integer"
        },
        "quiz_rang": {
         "type": "object",
         "additionalProperties": {
          "type": "integer"
         }
        }
       }
      },
      "bonus": {
       "type": "object",
       "required": [
        "parfait",
        "chrono",
        "du_jour"
       ],
       "additionalProperties": {
        "type": "integer"
       }
      },
      "echec": {
       "type": "object",
       "required": [
        "quiz",
        "rappel"
       ],
       "additionalProperties": {
        "type": "integer"
       }
      },
      "tour_suivant": {
       "type": "object",
       "required": [
        "multiplicateur_recul",
        "quiz_parfaits_prison"
       ],
       "additionalProperties": {
        "type": "integer"
       }
      },
      "textes": {
       "type": "object",
       "additionalProperties": {
        "$ref": "#/$defs/texte"
       }
      }
     }
    },
    "epoques": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "nom",
       "debut",
       "fin",
       "icone"
      ],
      "properties": {
       "id": {
        "enum": [
         "antiquite",
         "moyen-age",
         "renaissance",
         "classique",
         "xixe",
         "xxe"
        ]
       },
       "nom": {
        "$ref": "#/$defs/texte"
       },
       "debut": {
        "type": [
         "integer",
         "null"
        ]
       },
       "fin": {
        "type": [
         "integer",
         "null"
        ]
       },
       "icone": {
        "$ref": "#/$defs/id"
       }
      }
     }
    },
    "palette": {
     "$ref": "#/$defs/palette"
    },
    "taille": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     },
     "minItems": 2,
     "maxItems": 2
    },
    "icones": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/pixels"
     }
    },
    "cases": {
     "type": "array",
     "minItems": 2,
     "items": {
      "type": "object",
      "required": [
       "n",
       "id",
       "annee",
       "titre",
       "stat",
       "epoque",
